# =============================================================================
# Explainable AI for News Integrity - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------

# Google Gemini API - required for LLM explanations
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API - optional, used for claim extraction
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Perplexity API - optional, used for web-search fact-checking
# Get your key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Legacy / currently unused:
# The app now uses Perplexity for fact-checking instead of Google Fact Check.
# GOOGLE_FACTCHECK_API_KEY=your-factcheck-api-key-here

# -----------------------------------------------------------------------------
# Model Paths (Optional - defaults provided)
# -----------------------------------------------------------------------------

# Path to fine-tuned RoBERTa model for fake news detection
# AUTO-DETECTED by default:
#   - Cloud Run (K_SERVICE env var present): /mnt/gcs/models/checkpoint_roberta
#   - Local development: ./models/checkpoint_roberta
# Uncomment to override:
# DETECTOR_MODEL_PATH=/custom/path/to/model

# Sentence Transformer model path override.
# AUTO-DETECTED by default:
#   - Cloud Run (K_SERVICE env var present): /mnt/gcs/models/all-MiniLM-L6-v2
#   - Local development: sentence-transformers/all-MiniLM-L6-v2
# Uncomment to override:
# SENTENCE_TRANSFORMER_PATH=/custom/path/to/all-MiniLM-L6-v2

# Path to local ChromaDB Wikipedia database.
# Used when USE_POSTGRES=false.
CHROMA_DB_PATH=./data/chroma_db_wiki

# -----------------------------------------------------------------------------
# Evidence Retrieval Backend
# -----------------------------------------------------------------------------

# Local development:
#   USE_POSTGRES=false uses ChromaDB at CHROMA_DB_PATH.
# Cloud/production:
#   USE_POSTGRES=true uses PostgreSQL + pgvector with POSTGRES_* credentials.
USE_POSTGRES=false

# Cloud SQL PostgreSQL connection.
# Required only when USE_POSTGRES=true.
POSTGRES_HOST=your-cloud-sql-ip-here
POSTGRES_PORT=5432
POSTGRES_DB=wikidb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here

# -----------------------------------------------------------------------------
# Google Cloud (For cloud deployment)
# -----------------------------------------------------------------------------

# GCS bucket for WikiDB storage
GCS_BUCKET_NAME=news-integrity-wikidb

# Path to WikiDB zip in GCS
GCS_WIKIDB_PATH=chroma_db_wiki.zip

# Cloud Run Retriever API URL (if deployed)
# CLOUD_RETRIEVER_URL=https://your-service-url.run.app

# -----------------------------------------------------------------------------
# Application Settings (Optional)
# -----------------------------------------------------------------------------

# Default extractor mode: "simple" or "claimify"
DEFAULT_EXTRACTOR_MODE=simple

# Claimify settings
CLAIMIFY_MAX_SENTENCES=5
CLAIMIFY_USE_PREFILTER=true

# Evidence limits
MAX_CLAIMS_PER_ARTICLE=10
MAX_EVIDENCE_PER_CLAIM=3
MAX_FACTCHECKS_PER_CLAIM=3
